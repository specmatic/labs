{
  "before": [
    {
      "type": "http",
      "executeFor": {
        "scenarios": "all"
      },
      "http-request": {
        "baseUrl": "${KEYCLOAK_BASE_URL:http://keycloak:8080}",
        "path": "/realms/specmatic/protocol/openid-connect/token",
        "method": "POST",
        "headers": {
          "Content-Type": "application/x-www-form-urlencoded"
        },
        "body": "grant_type=password&client_id=order-api&username=${KEYCLOAK_USER_USERNAME:default-username}&password=${KEYCLOAK_USER_PASSWORD:default-password}"
      },
      "http-response": {
        "status": 200,
        "body": {
          "access_token": "(ACCESS_TOKEN:string)"
        },
        "headers": {
          "Content-Type": "application/json"
        }
      }
    }
  ],
  "http-request": {
    "path": "/orders",
    "method": "POST",
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "productid": 10,
      "count": 1,
      "status": "pending"
    }
  },
  "http-response": {
    "status": 201,
    "body": {
      "id": 1
    },
    "headers": {
      "Content-Type": "application/json"
    }
  }
}
