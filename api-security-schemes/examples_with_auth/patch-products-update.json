{
  "before": [
    {
      "type": "http",
      "executeFor": {
        "scenarios": "all"
      },
      "http-request": {
        "baseUrl": "${KEYCLOAK_BASE_URL:http://vault-secret-not-loaded.invalid}",
        "path": "/realms/specmatic/protocol/openid-connect/token",
        "method": "POST",
        "headers": {
          "Content-Type": "application/x-www-form-urlencoded"
        },
        "body": "grant_type=password&client_id=order-api&username=${KEYCLOAK_SERVICE_ACCOUNT_USERNAME:missing-vault-service-account}&password=${KEYCLOAK_SERVICE_ACCOUNT_PASSWORD:missing-vault-password}"
      },
      "http-response": {
        "status": 200,
        "body": {
          "access_token": "(ACCESS_TOKEN:string)"
        },
        "headers": {
          "Content-Type": "application/json"
        }
      }
    }
  ],
  "partial": {
    "http-request": {
      "path": "/products/10",
      "method": "PATCH",
      "headers": {
        "Content-Type": "application/json",
        "Authorization": "Bearer $(ACCESS_TOKEN)"
      },
      "body": {}
    },
    "http-response": {
      "status": 200,
      "body": "success",
      "headers": {
        "Content-Type": "text/plain"
      }
    }
  }
}
